# Sewalo Mobile App - Environment Configuration Example
# API and Backend Base URL
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
# S3 Assets Base URL
EXPO_PUBLIC_S3_BASE_URL=https://sewalo-dev.s3.ap-south-1.amazonaws.com/
# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# PostHog Configuration
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_posthog_project_token_here
POSTHOG_API_KEY=phx_your_posthog_personal_api_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
