# Sewalo Mobile App - Environment Configuration Example

# API and Backend Base URLs
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# S3 Assets Base URL
EXPO_PUBLIC_S3_BASE_URL=https://sewalo-dev.s3.ap-south-1.amazonaws.com/


# Google Maps API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# PostHog Configuration
EXPO_PUBLIC_POSTHOG_API_KEY=your_posthog_project_api_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

